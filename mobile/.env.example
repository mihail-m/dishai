# Browser preview uses the Vite /api proxy and needs no setting.
# For an Android Emulator debug build using the existing local backend:
# VITE_API_BASE_URL=http://10.0.2.2:8000

# Optional Nominatim-compatible address-search endpoint; use a provider you operate
# or have configured for this app. Local street/landmark search works without it.
# VITE_GEOCODER_URL=https://your-geocoder.example/search
