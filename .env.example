# Copy to .env (git-ignored). Nothing here is required: without keys the app runs on MapLibre + OSM tiles
# and our own router, and the Google baseline / snapped route are simply not shown.

# Initial basemap: google | maplibre | leaflet (Leaflet 1.9.4 + OpenStreetMap).
# The map toolbar lets each browser choose and remember a renderer without rebuilding.
# Default: google if a browser key is set, else maplibre.
MAP_PROVIDER=maplibre

# Browser key: restrict by HTTP referrer, enable only Maps JavaScript API + Places. Set a daily quota cap.
GOOGLE_MAPS_BROWSER_KEY=

# Server key: restrict by IP / API, enable only Routes API. Set a daily quota cap. Read by the backend only,
# never exposed to the browser, never logged.
GOOGLE_ROUTES_SERVER_KEY=
# The same key also drives the real-traffic layer (typical and live arterial travel times) and the Google Air Quality + Pollen card,
# so enable the Routes, Air Quality and Pollen APIs on it. Traffic requests are capped per day (defaults below); a restart re-uses
# data/traffic_profile.json (7 days) so the hour-of-week profile is not re-requested.
# TRAFFIC_GOOGLE_DAILY_MAX=1500
# TRAFFIC_TOMTOM_DAILY_MAX=2300

# Municipal reference stations via aqicn.org (optional). Free token: https://aqicn.org/data-platform/token
# Terms (aqicn.org/api): attribution is mandatory, no archiving/redistribution of the data (it is held in memory
# only here), non-profit public use needs advance notice by email to the WAQI team, for-profit needs agreement.
WAQI_TOKEN=

# TomTom Traffic API key (live traffic flow + incidents). Free tier: 50,000 tile requests/day, 2,500 other/day.
TOMTOM_API_KEY=

# Alerts (docs/ALERTS.md). Everything is optional.
# NASA FIRMS key for active-fire detections upwind of Sofia (smoke alerts). Free: https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=
# Web push: run `python -m backend.push --gen-keys` and paste the three lines it prints. Needs the pywebpush package (requirements.txt).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.org
